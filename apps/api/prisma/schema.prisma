generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CostCategory {
  DISPOSAL
  LABOR
  VEHICLE
  MACHINERY
  ATTACHMENT
  LEASE
  SUBCONTRACT
  MISC
}

model Project {
  id            Int         @id @default(autoincrement())
  companyId     Int
  name          String?
  hasAdditionalWork Boolean?
  targetProfitMargin Int?
  laborUnitPrice Int?
  address       String
  structure     String
  areaTsubo     Float
  contractPrice Int
  plannedEndDate DateTime? @db.Date
  originalPlannedEndDate DateTime? @db.Date
  completedDate DateTime? @db.Date
  startDate     DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  costs         CostEntry[]
  calendarEntry CalendarEntry?

  @@index([companyId])
}

model CostEntry {
  id         Int          @id @default(autoincrement())
  projectId  Int
  category   CostCategory
  detail     String?
  amount     Int
  disposalQuantity Decimal? @db.Decimal(7, 1)
  disposalUnit String?
  disposalUnitPrice Int?
  disposalTaxRate Decimal? @db.Decimal(5, 2)
  disposalSubtotal Int?
  disposalTaxAmount Int?
  laborCount Decimal? @db.Decimal(5, 1)
  laborUnitPrice Int?
  occurredAt DateTime
  memo       String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Company {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
  calendarEntries CalendarEntry[]
}

model CalendarEntry {
  id Int @id @default(autoincrement())
  companyId Int
  projectId Int? @unique
  title String
  recorderName String
  startDate DateTime @db.Date
  plannedEndDate DateTime? @db.Date
  memo String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  @@index([companyId])
}

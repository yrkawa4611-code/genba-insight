generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CostCategory {
  DISPOSAL
  LABOR
  VEHICLE
  MACHINERY
  ATTACHMENT
  LEASE
  SUBCONTRACT
  MISC
}

model Project {
  id            Int         @id @default(autoincrement())
  companyId     Int
  address       String
  structure     String
  areaTsubo     Float
  contractPrice Int
  startDate     DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  costs         CostEntry[]

  @@index([companyId])
}

model CostEntry {
  id         Int          @id @default(autoincrement())
  projectId  Int
  category   CostCategory
  detail     String?
  amount     Int
  occurredAt DateTime
  memo       String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Company {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
}

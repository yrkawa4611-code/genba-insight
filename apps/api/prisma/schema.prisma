generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CostCategory {
  DISPOSAL
  LABOR
  VEHICLE
  MACHINERY
  ATTACHMENT
  LEASE
  SUBCONTRACT
  MISC
}

model Project {
  id            Int         @id @default(autoincrement())
  address       String
  structure     String
  areaTsubo     Float
  contractPrice Int
  startDate     DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  costs         CostEntry[]
}

model CostEntry {
  id         Int          @id @default(autoincrement())
  projectId  Int
  category   CostCategory
  amount     Int
  occurredAt DateTime
  memo       String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}